{
  "name": "discrete-tasks",
  "private": true,
  "version": "0.1.0",
  "description": "A calm, offline-first PWA with university-level discrete-math problems.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify/run-all.ts",
    "verify:bank": "tsx scripts/verify/run-all.ts",
    "format": "prettier --write .",
    "e2e": "playwright test"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
